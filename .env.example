# Copiá este archivo a .env y completá tus credenciales reales. .env está gitignored.

# Capital.com — generar la API key en la app: Settings > API integrations > Generate new key
# Necesitás las TRES cosas para autenticar (POST /session):
CAPITAL_API_KEY=replace_with_your_capitalcom_api_key
CAPITAL_IDENTIFIER=tu_email_de_login@ejemplo.com
CAPITAL_API_PASSWORD=el_password_custom_que_definiste_al_crear_la_key
CAPITAL_ENVIRONMENT=demo   # 'demo' o 'live'

# Telegram — bot SEPARADO del de us30_alerts. Crear uno nuevo con @BotFather,
# pegar acá su token, y obtener el chat_id enviándole /start y visitando
# https://api.telegram.org/bot<TOKEN>/getUpdates . Dejar vacío = sin notificaciones.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pushover (opcional) — app propia del trader. Dejar vacío para no usar.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
